; ; !(list-avg (STV ((STV 2 3) (STV 3 4) (STV 2 3)) ))
; !(list-average (STV 0.88 0.84) (STV 0.9 0.86))
(= (lcg-formula (STV $sc1 $cc1)
                    (STV $sc2 $cc2)
                    (STV $slcg $clcg)
                    (STV $sc1lcg $cc1lcg)
                    (STV $sc2lcg $cc2lcg))
   (if (== (get-metatype $sc1lcg) Expression)
        (let (STV $sc1lcgf $cc1lcgf) (list-average $sc1lcg)
            (STV (+ (/safe (* (* $sc1lcgf $sc2lcg) $slcg)
                        $sc2)
                (/safe (* $slcg (* (- 1 $sc1lcgf) (- 1 $sc2lcg)))
                        (- 1 $sc2)))
                (Truth_w2c (min $cc1lcgf $cc2lcg))
            )
        )
        (if (== (get-metatype $sc2lcg) Expression)
            (let (STV $sc2lcgf $cc2lcgf) (list-average $sc2lcg)
                (STV (+ (/safe (* (* $sc1lcg $sc2lcgf) $slcg)
                        $sc2)
                    (/safe (* $slcg (* (- 1 $sc1lcg) (- 1 $sc2lcgf)))
                            (- 1 $sc2)))
                    (Truth_w2c (min $cc1lcg $cc2lcgf))
                )
            )
            (STV (+ (/safe (* (* $sc1lcg $sc2lcg) $slcg)
                  $sc2)
                (/safe (* $slcg (* (- 1 $sc1lcg) (- 1 $sc2lcg)))
                    (- 1 $sc2)))
                (Truth_w2c (min $cc1lcg $cc2lcg))
            )
        )
    ))

; !(lcg-formula (STV 0.9 0.86) (STV 0.88 0.84) (STV 0.9 0.86) (STV 0.9 0.86) (STV 0.88 0.84))