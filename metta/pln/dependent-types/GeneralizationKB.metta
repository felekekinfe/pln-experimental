;; Generalization Knowledge Base for Common Concepts(Water and Land)
(: Predicate Type)
(: → (-> Predicate Predicate Expression Type))
(: water Predicate)
(: land Predicate)
(: medium Predicate)

(: kb (-> Atom))
(= (knowledge-base) (superpose(
